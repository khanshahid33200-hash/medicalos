# Environment
ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://clinic_user:clinic_pass@localhost:5432/clinic_os

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-fernet-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# Anthropic Claude API
ANTHROPIC_API_KEY=your_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# n8n Workflow Integration
N8N_WEBHOOK_SECRET=your_webhook_secret
N8N_BASE_URL=http://localhost:5678

# Supabase (optional, if using Supabase-hosted Postgres)
SUPABASE_URL=
SUPABASE_KEY=

# OCR (Tesseract path)
TESSERACT_PATH=/usr/bin/tesseract

# API Settings
API_TITLE=Clinic OS
API_VERSION=1.0.0
API_DESCRIPTION=Patient workflow automation platform for clinics
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Email (for alerts/notifications)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# AWS S3 (for PDF storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=clinic-os-reports
