# Database
DATABASE_URL=postgresql://user:password@localhost:5432/med_rapidly
DIRECT_URL=postgresql://user:password@localhost:5432/med_rapidly

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRES_IN=7d

# Session
SESSION_SECRET=your-super-secret-session-key-min-32-characters

# AWS S3 (for PDF prescriptions)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=med-rapidly-prescriptions

# Voice API
CLAUDE_API_KEY=
VOICE_WEBHOOK_SECRET=

# Email/WhatsApp (optional providers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Business
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=
